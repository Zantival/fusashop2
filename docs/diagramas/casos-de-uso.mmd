flowchart LR
    consumidor["👤 Cliente"]
    comerciante["🏪 Comerciante"]
    admin["🛡️ Administrador / Analista"]
    proveedor["🔌 Servicios externos"]

    catalogo([Explorar catálogo y tiendas])
    compra([Gestionar carrito y comprar])
    cuenta([Gestionar cuenta y direcciones])
    resena([Calificar productos])
    soporte([Enviar mensajes y PQRS])
    tienda([Administrar tienda y productos])
    ventas([Gestionar pedidos e inventario])
    reportes([Consultar ventas y finanzas])
    pauta([Solicitar pauta publicitaria])
    usuarios([Administrar usuarios y KYC])
    plataforma([Gestionar banners, PQRS y configuración])
    analitica([Consultar reportes y ejecutar análisis])
    pago([Procesar pagos y notificaciones])
    envio([Cotizar, etiquetar y rastrear envíos])
    factura([Emitir factura electrónica])
    correo([Enviar códigos y notificaciones por correo])


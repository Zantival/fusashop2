# Plantilla para el hosting. Copiar los valores necesarios al .env del servidor.
# No subir este archivo como .env ni incluir secretos en Git.
APP_NAME=FusaShop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Bogota
APP_URL=https://TU-DOMINIO

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=USUARIO_NOMBRE_BASE
DB_USERNAME=USUARIO_BASE
DB_PASSWORD=CAMBIAR_POR_CLAVE_SEGURA

SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=resend
MAIL_FROM_ADDRESS=ventas@TU-DOMINIO
MAIL_FROM_NAME="FusaShop"
RESEND_API_KEY=

# Crear/restringir el cliente OAuth para el dominio de producción.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

# Usar credenciales productivas reales. El simulador de pagos solo funciona en local/testing.
WOMPI_ENV=production
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

ENVIA_ENV=production
ENVIA_API_TOKEN=
ENVIA_DEFAULT_CARRIER=servientrega
ENVIA_WEBHOOK_SECRET=
ENVIA_ORIGIN_NAME="FusaShop"
ENVIA_ORIGIN_EMAIL=despachos@TU-DOMINIO
ENVIA_ORIGIN_PHONE=
ENVIA_ORIGIN_STREET=
ENVIA_ORIGIN_NUMBER=
ENVIA_ORIGIN_DISTRICT=
ENVIA_ORIGIN_CITY=Fusagasuga
ENVIA_ORIGIN_STATE=CU
ENVIA_ORIGIN_POSTAL_CODE=252211

FACTUS_ENV=production
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
FACTUS_NUMBERING_RANGE_ID=
FACTUS_DEFAULT_MUNICIPALITY_CODE=25290
FACTUS_DEFAULT_MUNICIPALITY_ID=149
FACTUS_IVA_RATE=19

PLATFORM_COMMISSION_RATE=0.08
STOCK_RESERVATION_MINUTES=30
MCP_TOKEN=
